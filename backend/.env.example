APP_ENV=development
DATABASE_URL=postgresql+asyncpg://rfm:rfm@127.0.0.1:5432/rfm
DEVICE_CODE=rfm-demo-001
DEVICE_SECRET=replace-with-64-random-hex-characters
DEVICE_API_BASE_URL=http://127.0.0.1:8000
DEVICE_SECRET_ENCRYPTION_KEY=replace-with-separate-64-random-hex-characters
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=2592000
WECHAT_APP_ID=your-wechat-mini-program-appid
WECHAT_APP_SECRET=keep-this-only-on-the-backend
# Until a subscription template is approved, use mock locally and disabled
# in production. Change to wechat only after filling the template fields.
REMINDER_DELIVERY_MODE=mock
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_ITEMS_KEY=thing1
WECHAT_REMINDER_COUNT_KEY=number2
WECHAT_REMINDER_DATE_KEY=date3
WECHAT_REMINDER_PAGE=pages/today/index
ALLOW_DEV_LOGIN=true
DATABASE_INVENTORY_ENABLED=false

# Use mock locally without spending model quota. Production uses hunyuan.
RECOGNITION_PROVIDER=mock
RECOGNITION_EXECUTION_MODE=inline
RECOGNITION_UPLOAD_DIR=data/recognition
RECOGNITION_MAX_IMAGE_BYTES=5242880
RECOGNITION_MAX_IMAGES=9
RECOGNITION_IMAGE_CONCURRENCY=2
RECOGNITION_TASK_TTL_SECONDS=86400
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_TEXT_MODEL=hy3
HUNYUAN_VISION_MODEL=hy-vision-2.0-instruct
HUNYUAN_TIMEOUT_SECONDS=60

# 墨水屏相册。本地开发将处理后的四色 PNG 保存到本机目录；原图不落盘。
DISPLAY_PHOTO_STORAGE_BACKEND=local
DISPLAY_PHOTO_LOCAL_DIR=data/display-photos
DISPLAY_PHOTO_MAX_IMAGE_BYTES=5242880
DISPLAY_PHOTO_MAX_PHOTOS=6

# 黄历天气。本地用 mock；生产改为 qweather 并配置和风天气 JWT 凭据。
WEATHER_DATA_PROVIDER=mock
WEATHER_REFRESH_HOURS=3
WEATHER_FAILURE_RETRY_MINUTES=15
WEATHER_STALE_HOURS=12
WEATHER_DATA_TIMEOUT_SECONDS=12
QWEATHER_API_HOST=
QWEATHER_CREDENTIAL_ID=
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
# Ed25519 私钥 PEM 的单行 Base64；不要提交真实值。
QWEATHER_PRIVATE_KEY_BASE64=

MARKET_DATA_PROVIDER=mock
MARKET_SECURITY_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_BASE_URL=https://api.twelvedata.com
COINGECKO_API_KEY=
COINGECKO_API_KEY_TYPE=demo
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
LONGBRIDGE_ENABLE_OVERNIGHT=false
LONGBRIDGE_PAPER_TRADING=true
MARKET_DATA_TIMEOUT_SECONDS=12

# OTA 固件必须是 Arduino 官方 bin_signing.py 生成的 ECDSA P-256 签名包。
# 生产环境使用绝对路径，并将该目录挂载为持久化私有目录；禁止通过静态站点公开。
OTA_FIRMWARE_STORAGE_DIR=data/firmware-releases
OTA_MAX_SIGNED_BINARY_BYTES=3145728

# 生产环境改为 cos，并填写同地域私有 COS 存储桶信息。
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
