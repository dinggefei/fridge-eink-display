# Public endpoint. Replace after the domain is registered.
API_DOMAIN=api.example.com
ACME_EMAIL=your-email@example.com

# Optional package mirror used only while building the backend image.
# Tencent Cloud mainland servers can use:
PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# PostgreSQL. Use a random hexadecimal password to avoid URL escaping issues.
POSTGRES_DB=rfm
POSTGRES_USER=rfm
POSTGRES_PASSWORD=replace-with-random-hex

# FastAPI production settings.
APP_ENV=production
AUTH_TOKEN_SECRET=replace-with-at-least-64-random-hex-characters
AUTH_TOKEN_TTL_SECONDS=2592000
ALLOW_DEV_LOGIN=false
DATABASE_INVENTORY_ENABLED=true

# WeChat mini program. Keep the AppSecret only on the server.
WECHAT_APP_ID=replace-with-wechat-appid
WECHAT_APP_SECRET=replace-with-wechat-appsecret
REMINDER_DELIVERY_MODE=disabled
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_ITEMS_KEY=thing1
WECHAT_REMINDER_COUNT_KEY=number2
WECHAT_REMINDER_DATE_KEY=date3
WECHAT_REMINDER_PAGE=pages/today/index

# ESP32 device credentials. These must match the flashed firmware.
DEVICE_CODE=replace-with-device-code
DEVICE_SECRET=replace-with-device-secret
DEVICE_API_BASE_URL=https://api.example.com
DEVICE_SECRET_ENCRYPTION_KEY=replace-with-separate-64-random-hex-characters

# Recognition. Generate an OpenAI-compatible API key in Tencent Hunyuan.
RECOGNITION_PROVIDER=hunyuan
RECOGNITION_EXECUTION_MODE=worker
RECOGNITION_MAX_IMAGE_BYTES=5242880
RECOGNITION_MAX_IMAGES=9
RECOGNITION_IMAGE_CONCURRENCY=2
RECOGNITION_TASK_TTL_SECONDS=86400
HUNYUAN_API_KEY=replace-with-hunyuan-api-key
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_TEXT_MODEL=hy3
HUNYUAN_VISION_MODEL=hy-vision-2.0-instruct
HUNYUAN_TIMEOUT_SECONDS=60

# 墨水屏相册。存储桶必须是私有读写，建议与服务器位于同一地域。
DISPLAY_PHOTO_STORAGE_BACKEND=cos
DISPLAY_PHOTO_MAX_IMAGE_BYTES=5242880
DISPLAY_PHOTO_MAX_PHOTOS=6

# 黄历天气。API Host 使用和风天气控制台分配的专属域名。
WEATHER_DATA_PROVIDER=qweather
WEATHER_REFRESH_HOURS=3
WEATHER_FAILURE_RETRY_MINUTES=15
WEATHER_STALE_HOURS=12
WEATHER_DATA_TIMEOUT_SECONDS=12
QWEATHER_API_HOST=replace-with-your-qweather-api-host
QWEATHER_CREDENTIAL_ID=replace-with-qweather-credential-id
QWEATHER_DEVELOPER_ID=replace-with-qweather-developer-id
QWEATHER_PROJECT_ID=replace-with-qweather-project-id
# Ed25519 私钥 PEM 的单行 Base64；仅保存在生产环境变量中。
QWEATHER_PRIVATE_KEY_BASE64=replace-with-base64-encoded-ed25519-private-key

MARKET_DATA_PROVIDER=live
MARKET_SECURITY_PROVIDER=longbridge
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_BASE_URL=https://api.twelvedata.com
COINGECKO_API_KEY=
COINGECKO_API_KEY_TYPE=demo
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
LONGBRIDGE_APP_KEY=replace-with-longbridge-app-key
LONGBRIDGE_APP_SECRET=replace-with-longbridge-app-secret
LONGBRIDGE_ACCESS_TOKEN=replace-with-paper-account-access-token
# AP/亚洲账户部署在中国大陆服务器时可使用 .cn 接入点。
LONGBRIDGE_HTTP_URL=https://openapi.longbridge.cn
LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.cn/v2
LONGBRIDGE_ENABLE_OVERNIGHT=false
LONGBRIDGE_PAPER_TRADING=true
MARKET_DATA_TIMEOUT_SECONDS=12
COS_REGION=replace-with-cos-region
COS_BUCKET=replace-with-private-cos-bucket-appid
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key

# ESP32 签名 OTA。compose 会把该目录固定到私有持久化卷。
OTA_FIRMWARE_STORAGE_DIR=/app/data/firmware-releases
OTA_MAX_SIGNED_BINARY_BYTES=3145728
